# =============================================================
#  Juniper-Project  —  React + FastAPI  .gitignore
# =============================================================

# -----------------------------------------------------------
# Python / FastAPI (backend)
# -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.env.bak

# Distribution / build artefacts
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Test & coverage
.pytest_cache/
.coverage
htmlcov/
*.xml
nosetests.xml
coverage.xml

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# SQLite / local databases (dev only)
*.db
*.sqlite3

# -----------------------------------------------------------
# Environment / secrets  ← NEVER commit these
# -----------------------------------------------------------
.env
.env.*
!.env.example          # allow the example template

# -----------------------------------------------------------
# Node.js / React (frontend)
# -----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production build output
frontend/dist/
frontend/build/
frontend/.next/

# Vite cache
frontend/.vite/

# -----------------------------------------------------------
# IDEs & editors
# -----------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# -----------------------------------------------------------
# OS artefacts
# -----------------------------------------------------------
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
